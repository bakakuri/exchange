# Server
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Request timeout (milliseconds; default 30 000 = 30 s)
# Increase only if you have known long-running operations (e.g. bulk exports).
# Must stay below Vercel's platform limit (60 s Hobby / 300 s Pro).
REQUEST_TIMEOUT_MS=30000
