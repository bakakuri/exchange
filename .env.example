# Server
PORT=3000
# Public site URL: CORS origin + links in sign-up / password-reset emails.
# On Vercel set it to your production URL (e.g. https://exchange-ivory-one.vercel.app);
# if unset there, Vercel's own VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL is used.
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
# !! This file is a TEMPLATE and is committed to git - never put real keys here.
# !! Real values go in .env (git-ignored) locally, and in Vercel ->
# !! Settings -> Environment Variables in production.
SUPABASE_URL=
# Publishable key (sb_publishable_...) - or the legacy anon JWT
SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) - or the legacy service_role JWT. Bypasses RLS:
# full database access. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Request timeout (milliseconds; default 30 000 = 30 s)
# Increase only if you have known long-running operations (e.g. bulk exports).
# Must stay below Vercel's platform limit (60 s Hobby / 300 s Pro).
REQUEST_TIMEOUT_MS=30000
